# MediaLith — x86-64 UEFI appliance target.
#
# Every option here was resolved by actually running Buildroot's kconfig against this
# file, not by reading option names out of the tree. That distinction earned its keep:
# four options were being silently dropped because their dependencies were unmet, and
# a dropped option in kconfig is not an error — it just quietly leaves you with
# something else. The first run of this file produced a uClibc toolchain, on which
# Plex Media Server cannot run at all.
#
# To re-check after editing (seconds, no compilation):
#
#   make -C <buildroot> BR2_EXTERNAL=$(pwd) O=<out> plexos_x86_64_defconfig
#   grep -c '^BR2_PACKAGE_INTEL_MEDIADRIVER=y' <out>/.config
#
# Reference machine: Huawei WRT-WX9, Core i5-8265U (Whiskey Lake-U, Gen9.5),
# Intel UHD Graphics 620 [8086:3ea0], Intel Wireless-AC 9560 [8086:9df0], NVMe.
#
#   make -C <buildroot> BR2_EXTERNAL=$(pwd) O=$(pwd)/output plexos_x86_64_defconfig

BR2_x86_64=y
BR2_x86_corei7=y

# glibc is not a preference. Plex Media Server is a closed-source binary linked
# against it, so musl and uClibc are not options (ADR-0002).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# glibc requires kernel headers >= 3.2, and without an explicit headers version
# kconfig silently drops the glibc choice and leaves uClibc selected — taking most of
# this file down with it. Matching headers to the kernel we build is the right answer
# for an appliance where we control both.
BR2_KERNEL_HEADERS_AS_KERNEL=y
# C++ is needed by intel-gmmlib, mesa3d, and liburcu (via xfsprogs). This is the
# user-facing option; BR2_INSTALL_LIBSTDCPP is a hidden bool it selects and cannot be
# set directly from a defconfig.
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# /usr is the image; a merged /usr is what makes that possible at all (ADR-0001).
BR2_ROOTFS_MERGED_USR=y

# plexos-init is PID 1. No BusyBox init, no systemd.
BR2_INIT_NONE=y
# ...and here is the thing that provides it. BR2_INIT_NONE only means Buildroot
# installs no init of its own; without this the image has no PID 1 at all and
# post-image.sh has nothing to put in the initrd.
BR2_PACKAGE_PLEXOS_INIT=y
# plexosd runs the boot health gate. Without it nothing ever clears the try counter,
# so every update would eventually roll back however well it worked (ADR-0005).
BR2_PACKAGE_PLEXOSD=y

# ---------------------------------------------------------------------------
# Kernel
# ---------------------------------------------------------------------------
BR2_LINUX_KERNEL=y
# Take the version Buildroot pins rather than naming our own. Buildroot bumps it
# deliberately, and we pin Buildroot — so this is still a deliberate pin, with the
# advantage that BR2_KERNEL_HEADERS_AS_KERNEL can then infer the toolchain headers
# version. A custom version leaves that inference impossible and the headers unset.
#
# TODO: revisit whether an LTS series is wanted before the first public image. That
# decision now also drags the headers question with it, so it is not purely a kernel
# choice any more.
BR2_LINUX_KERNEL_LATEST_VERSION=y

# A fragment rather than a full linux.config. Carrying thousands of lines of
# architecture defaults obscures the handful of options MediaLith actually requires, and
# makes every kernel bump a merge conflict. The fragment states our requirements and
# nothing else.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PLEXOS_PATH)/board/plexos/x86_64/linux.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
# objtool needs libelf, and the x86-64 default config enables CONFIG_UNWINDER_ORC,
# which needs objtool. Without this the kernel build dies on "gelf.h: No such file or
# directory" four hours in — and nothing before that point gives any warning, because
# the requirement comes from the architecture defaults rather than from anything in
# linux.fragment. This builds host-elfutils rather than requiring libelf-dev on the
# build host, keeping the dependency inside Buildroot where the rest of them live.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# ---------------------------------------------------------------------------
# Filesystem images
# ---------------------------------------------------------------------------
# erofs for /usr: designed for read-only images, and better random-read behaviour than
# squashfs, which matters when every binary faults in from it (ADR-0003).
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
# Buildroot's default tar image is not useful to us and doubles image build time.
# BR2_TARGET_ROOTFS_TAR is not set

# ---------------------------------------------------------------------------
# Graphics and hardware transcoding
# ---------------------------------------------------------------------------
# intel-mediadriver selects intel-gmmlib, libpciaccess, libva, and mesa3d itself.
BR2_PACKAGE_INTEL_MEDIADRIVER=y
# vainfo. Not a debugging luxury: plexos-gpu runs it as the boot-time self-test, so it
# is a required component of the health gate. Selected by BR2_PACKAGE_PLEXOS_GPU too,
# so it cannot be dropped without noticing.
BR2_PACKAGE_LIBVA_UTILS=y
# The diagnostic this project exists for (ARCHITECTURE.md section 6). It was missing
# from the first images that booted, which made the one question the appliance is
# supposed to answer the one thing it could not.
BR2_PACKAGE_PLEXOS_GPU=y
# NVIDIA's open kernel modules (ADR-0015 step 3). Turing and later; Blackwell requires
# the open variant rather than the proprietary one, which is why this is the version
# worth carrying rather than a compromise. Needs CONFIG_MODULES=y, reversed in the
# fragment for exactly this. Builds the kernel side only -- GSP firmware and the
# proprietary userspace are steps 4 and 5, and neither is here yet, so this alone does
# not transcode.
BR2_PACKAGE_PLEXOS_NVIDIA=y

# ---------------------------------------------------------------------------
# Firmware
# ---------------------------------------------------------------------------
BR2_PACKAGE_LINUX_FIRMWARE=y
# GuC/HuC. HuC is what gives QuickSync its quality at low bitrates, and its absence is
# silent — which is the whole reason plexos-gpu::firmware exists.
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
# The same, for the *other* Intel driver. The kernel fragment sets CONFIG_DRM_XE=y, so
# `xe` binds to Lunar Lake, Battlemage and Panther Lake — and the image carried firmware
# for i915 alone, which made "current Arc works here" a claim about a card that binds and
# then finds no blob. Eight files, 4 MiB, so unlike the wireless families there is nothing
# to choose between. `xe` asks for them as `xe/<plat>_guc_<major>.bin`, with the directory
# part of the request, which is why post-image.sh copies the subdirectory rather than the
# files. Unverifiable here: none of the hardware this runs on is driven by `xe`.
BR2_PACKAGE_LINUX_FIRMWARE_XE=y
# Intel wireless. These blobs must reach the *initramfs*, not just /usr -- CONFIG_IWLWIFI=y,
# so the driver probes before /usr is mounted, and with no firmware it registers no netdev
# at all. post-image.sh stage 3 copies them.
#
# One symbol per card family, and the mapping is not guessable from the names: each of
# these was read out of linux-firmware.mk rather than inferred, after a symbol chosen by
# its number turned out to ship a family nothing here has. What each installs:
#
#   9XXX   iwlwifi-9???-*, so-a0-jf-b0-*      Wireless-AC 9560 -- the reference laptop
#   22000  iwlwifi-Qu-*, iwlwifi-QuZ-*        AX200/AX201 as CNVi (Comet Lake, Tiger Lake)
#   22260  iwlwifi-cc-a0-*                    AX200/AX201 discrete (Cyclone Peak)
#   6E     iwlwifi-{so,ty}-a0-gf-a0*          AX210 and AX211 -- Alder Lake and later
#
# 6E is the one that is easy to miss and the one the second laptop needs: an Alder Lake
# machine's built-in card is an AX211, whose blobs are named for the silicon (`so-a0-gf-a0`)
# and not for anything a person would search for. "22000" reads like the modern family and
# is in fact the Qu parts alone -- so a defconfig carrying 22000 and not 6E ships 53 MiB of
# firmware to a machine that asks for none of it and still comes up with no wlan0.
#
# 6E is also the only one whose devices need a `.pnvm` file, which is not a `.ucode` and so
# is not matched by anything looking for one. install_wifi_firmware carries them.
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
# Realtek USB Gigabit adapters (r8152). The reference laptop has no built-in Ethernet,
# and a media server on wireless is not a serious configuration — see the note below.
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
# And the PCIe side of the same vendor, which is a different symbol and was missing.
# The RTX desktop's onboard NIC asked for it and did not get it:
#
#   r8169 0000:03:00.0: Unable to load firmware rtl_nic/rtl8168h-2.fw (-2)
#
# The link still came up at 1Gbps, which is why this would have gone unnoticed: r8169
# falls back to running the PHY without the vendor's errata fixes and power-management
# tables rather than refusing to work. Degraded and silent, like the GuC firmware and
# for the same reason -- a firmware list assembled for the machines in the room.
#
# RTL_815X is the USB adapters (rtl8153*), which is what the reference laptop uses and
# is why only that one was here.
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
# The wireless regulatory database. cfg80211 asks for it as firmware; without it the
# kernel uses the world domain, which is legal everywhere and weaker than the card is.
BR2_PACKAGE_WIRELESS_REGDB=y

# ---------------------------------------------------------------------------
# Wireless
# ---------------------------------------------------------------------------
# The kernel has had CONFIG_IWLWIFI, CFG80211 and MAC80211 built in from the start; what
# was missing was any userspace to associate with an access point. nl80211 is the current
# interface and the only one worth building against -- wext is deprecated and iwlwifi does
# not offer it.
#
# wpa_cli matters as much as the daemon: it is how a scan is requested and read, how a
# network is added, and how the console asks whether association succeeded. It is also
# what makes wireless configurable from the shell on the attached screen, which is the
# only way in on a machine with no wired connection at all.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
# Turns a passphrase into a PSK, so the passphrase itself need not be written to /var --
# for WPA2. WPA3 derives its key from the passphrase inside the handshake and cannot take
# a precomputed one, which is why plexosd stores one or the other rather than always the
# hash.
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# WPA3. **Not on by default**, and the package builds and installs perfectly without it:
# `wpa_supplicant` is then a program that cannot join a WPA3 network and says so only when
# it reads a configuration naming SAE — `Line 6: invalid key_mgmt 'SAE'`, after which it
# exits 255. Third time in this project that a program present in the image turned out not
# to be a program that can do the job, after busybox tar without xz and mkfs.erofs without
# a compressor. Check the sub-options; the default is the smallest build.
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
# `iw` for scanning and for saying what the radio is actually doing. wpa_cli can scan, but
# a diagnostic that cannot run when the supplicant is not running is not a diagnostic.
BR2_PACKAGE_IW=y

# ---------------------------------------------------------------------------
# Storage and verity
# ---------------------------------------------------------------------------
# cryptsetup provides veritysetup, which plexos-init calls to establish dm-verity over
# /usr before mounting it (ADR-0004).
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_XFSPROGS=y
# erofs-utils on the *target*, not just the host: ADR-0010 provisions Plex on the
# device at first boot, which means the device builds the app image itself. It is also
# the only choice available — CONFIG_SQUASHFS is not set in the kernel fragment and
# CONFIG_EROFS_FS is, so erofs is what an app image can be, not what we prefer.
# busybox's losetup is a different program from util-linux's, not a smaller build of
# it: it has no --show, so it cannot report which device it attached, and mounting the
# Plex app image needs exactly that. util-linux is already in the image (erofs-utils
# selects it), so this is one applet rather than a package. The busybox fragment turns
# its own losetup off, so precisely one program owns /sbin/losetup and the result does
# not depend on which package Buildroot happens to install last.
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y

BR2_PACKAGE_EROFS_UTILS=y
# The target's mkfs.erofs is a different build from the host's, and only the host's had
# a compressor. Without this it is configured --disable-lz4, so provisioning downloads
# 83 MB, verifies Plex's signature, unpacks the payload and then fails with "Cannot find
# a valid compressor lz4hc" -- while post-image.sh builds /usr with lz4hc perfectly well,
# because that uses host-erofs-utils. lz4hc needs no separate option: erofs-utils detects
# LZ4_compress_HC_destSize in liblz4 and enables it alongside plain lz4.
BR2_PACKAGE_EROFS_UTILS_LZ4=y

# ---------------------------------------------------------------------------
# Plex provisioning (ADR-0010)
# ---------------------------------------------------------------------------
# Every Plex .deb carries a `_gpgplex` member: a clearsigned debsigs manifest listing
# each ar member's size and hashes, signed by Plex Inc.'s key
# CD665CBA0E2F88B7373F7CB997203C7B3ADCA79D — the same key that signs their APT
# repository. Verified against both channels on 2026-07-27.
#
# ADR-0010 requires that signature to be checked before anything is unpacked, and
# nothing in the image could check it: there was no gpg, no gpgv and no openssl.
#
# gnupg2 rather than gnupg: v1 is deprecated upstream. Selecting it brings the whole
# suite — there is no gpgv-only build, the GPGV symbol only controls whether gpgv
# survives installation — but /usr is 61 MiB of a 1024 MiB budget, so the room exists.
BR2_PACKAGE_GNUPG2=y
BR2_PACKAGE_GNUPG2_GPGV=y

# TLS, and the fact that none of this was here is worth recording. The image had no
# ssl_client applet, no curl, no openssl and no TLS library of any kind, while
# ADR-0010 has the appliance fetch Plex from downloads.plex.tv -- which serves HTTPS
# and nothing else. Provisioning could not have worked, and the symptom would have
# been a download failing on a machine whose network was demonstrably fine.
#
# ca-certificates is not optional either: without a trust store curl cannot verify
# Plex's certificate, and the alternative -- passing --insecure -- would make the
# transport prove nothing. The signature check (ADR-0010) is what establishes the
# artefact is Plex's; TLS is what stops someone watching which version is being
# fetched and feeding a different endpoint's answer.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Plex's public key, pinned into the verified /usr rather than fetched beside the
# artefact it is supposed to vouch for. See package/plexos-plex-keyring.
BR2_PACKAGE_PLEXOS_PLEX_KEYRING=y

# ---------------------------------------------------------------------------
# Host tooling for image assembly
# ---------------------------------------------------------------------------
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_GPTFDISK=y
# host veritysetup. The verity tree over the /usr image has to be computed on the
# build host, and its root hash embedded in the UKI command line before the UKI is
# signed (ADR-0004). The target-side BR2_PACKAGE_CRYPTSETUP above is a different
# thing entirely: that one is for the device, this one is for the image build.
BR2_PACKAGE_HOST_CRYPTSETUP=y
# host mkfs.erofs comes in via BR2_TARGET_ROOTFS_EROFS, which depends on
# host-erofs-utils (fs/erofs/erofs.mk). Not repeated here.

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# The unprivileged user Plex runs as (ADR-0007). Declared here rather than created at
# runtime so the uid is a property of the image: a uid invented on first boot would
# differ between a fresh install and a reinstall over the same /var, and the second
# machine would find a media database it does not own.
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_PLEXOS_PATH)/board/plexos/x86_64/users.table"

# busybox's tar is the only tar in the image, and Buildroot's default busybox
# configuration cannot read .xz -- which is both members of every Debian package
# ADR-0010 installs. See the fragment for what it costs and why it is xz alone.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PLEXOS_PATH)/board/plexos/x86_64/busybox.fragment"

BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PLEXOS_PATH)/board/plexos/x86_64/post-image.sh"

# ---------------------------------------------------------------------------
# Bootloader
# ---------------------------------------------------------------------------
# Our own package, not Buildroot's. Buildroot's BR2_PACKAGE_SYSTEMD_BOOT sits inside
# `if BR2_PACKAGE_SYSTEMD`, which is only ever selected by the BR2_INIT_SYSTEMD
# choice — taking it would pull systemd in as PID 1, exactly what BR2_INIT_NONE above
# rejects. package/plexos-systemd-boot builds the bootloader, and the UKI stub, alone
# from the same source. The prefix keeps our symbol distinct from upstream's, which
# kconfig would otherwise merge with ours without saying so.
BR2_PACKAGE_PLEXOS_SYSTEMD_BOOT=y

# ---------------------------------------------------------------------------
# Resolved
# ---------------------------------------------------------------------------
# UKI ASSEMBLY. systemd's `ukify` needs python-pefile, which Buildroot does not carry.
# Not a problem: a UKI is the EFI stub with .osrel, .cmdline, .linux, and .initrd PE
# sections added, which objcopy does. post-image.sh does it that way and avoids the
# dependency entirely; the host objcopy was confirmed to support pei-x86-64.
#
# The stub itself comes from package/plexos-systemd-boot, which builds linuxx64.efi.stub
# alongside the bootloader. Upstream Buildroot's systemd package never installs it,
# so without that addition there would be nothing to build a UKI around.

# ---------------------------------------------------------------------------
# Timezone data
# ---------------------------------------------------------------------------
# Without this there is no /usr/share/zoneinfo, and the consequence is not an error.
# Pointing /etc/localtime at a missing file succeeds, and every program then falls back
# to UTC silently -- so a timezone setting would appear to work and do nothing. That is
# the failure plexosd::settings refuses to produce, and this is what makes the refusal
# unnecessary.
#
# The symbol selects BR2_PACKAGE_TZDATA on a glibc toolchain, which is what this is, so
# the dependency is met -- checked against system/Config.in in the actual tree rather
# than recalled, and re-checked after kconfig runs, because options with unmet
# dependencies are dropped silently.
BR2_TARGET_TZ_INFO=y

# The full set. An appliance is wherever its owner is, and the alternative is a machine
# that cannot be set to the one zone somebody needs. A few megabytes against a 75 MB
# /usr image is not a trade worth thinking about twice.
BR2_TARGET_TZ_ZONELIST="default"

# Matches plexos_types::config::System::default_timezone, so a machine that has never
# been configured agrees with the configuration it would be given.
BR2_TARGET_LOCALTIME="UTC"
