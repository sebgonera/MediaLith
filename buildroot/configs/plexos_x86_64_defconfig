# PlexOS — x86-64 UEFI appliance target.
#
# Every option here was resolved by actually running Buildroot's kconfig against this
# file, not by reading option names out of the tree. That distinction earned its keep:
# four options were being silently dropped because their dependencies were unmet, and
# a dropped option in kconfig is not an error — it just quietly leaves you with
# something else. The first run of this file produced a uClibc toolchain, on which
# Plex Media Server cannot run at all.
#
# To re-check after editing (seconds, no compilation):
#
#   make -C <buildroot> BR2_EXTERNAL=$(pwd) O=<out> plexos_x86_64_defconfig
#   grep -c '^BR2_PACKAGE_INTEL_MEDIADRIVER=y' <out>/.config
#
# Reference machine: Huawei WRT-WX9, Core i5-8265U (Whiskey Lake-U, Gen9.5),
# Intel UHD Graphics 620 [8086:3ea0], Intel Wireless-AC 9560 [8086:9df0], NVMe.
#
#   make -C <buildroot> BR2_EXTERNAL=$(pwd) O=$(pwd)/output plexos_x86_64_defconfig

BR2_x86_64=y
BR2_x86_corei7=y

# glibc is not a preference. Plex Media Server is a closed-source binary linked
# against it, so musl and uClibc are not options (ADR-0002).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# glibc requires kernel headers >= 3.2, and without an explicit headers version
# kconfig silently drops the glibc choice and leaves uClibc selected — taking most of
# this file down with it. Matching headers to the kernel we build is the right answer
# for an appliance where we control both.
BR2_KERNEL_HEADERS_AS_KERNEL=y
# C++ is needed by intel-gmmlib, mesa3d, and liburcu (via xfsprogs). This is the
# user-facing option; BR2_INSTALL_LIBSTDCPP is a hidden bool it selects and cannot be
# set directly from a defconfig.
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# /usr is the image; a merged /usr is what makes that possible at all (ADR-0001).
BR2_ROOTFS_MERGED_USR=y

# plexos-init is PID 1. No BusyBox init, no systemd.
BR2_INIT_NONE=y
# ...and here is the thing that provides it. BR2_INIT_NONE only means Buildroot
# installs no init of its own; without this the image has no PID 1 at all and
# post-image.sh has nothing to put in the initrd.
BR2_PACKAGE_PLEXOS_INIT=y
# plexosd runs the boot health gate. Without it nothing ever clears the try counter,
# so every update would eventually roll back however well it worked (ADR-0005).
BR2_PACKAGE_PLEXOSD=y

# ---------------------------------------------------------------------------
# Kernel
# ---------------------------------------------------------------------------
BR2_LINUX_KERNEL=y
# Take the version Buildroot pins rather than naming our own. Buildroot bumps it
# deliberately, and we pin Buildroot — so this is still a deliberate pin, with the
# advantage that BR2_KERNEL_HEADERS_AS_KERNEL can then infer the toolchain headers
# version. A custom version leaves that inference impossible and the headers unset.
#
# TODO: revisit whether an LTS series is wanted before the first public image. That
# decision now also drags the headers question with it, so it is not purely a kernel
# choice any more.
BR2_LINUX_KERNEL_LATEST_VERSION=y

# A fragment rather than a full linux.config. Carrying thousands of lines of
# architecture defaults obscures the handful of options PlexOS actually requires, and
# makes every kernel bump a merge conflict. The fragment states our requirements and
# nothing else.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PLEXOS_PATH)/board/plexos/x86_64/linux.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
# objtool needs libelf, and the x86-64 default config enables CONFIG_UNWINDER_ORC,
# which needs objtool. Without this the kernel build dies on "gelf.h: No such file or
# directory" four hours in — and nothing before that point gives any warning, because
# the requirement comes from the architecture defaults rather than from anything in
# linux.fragment. This builds host-elfutils rather than requiring libelf-dev on the
# build host, keeping the dependency inside Buildroot where the rest of them live.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# ---------------------------------------------------------------------------
# Filesystem images
# ---------------------------------------------------------------------------
# erofs for /usr: designed for read-only images, and better random-read behaviour than
# squashfs, which matters when every binary faults in from it (ADR-0003).
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
# Buildroot's default tar image is not useful to us and doubles image build time.
# BR2_TARGET_ROOTFS_TAR is not set

# ---------------------------------------------------------------------------
# Graphics and hardware transcoding
# ---------------------------------------------------------------------------
# intel-mediadriver selects intel-gmmlib, libpciaccess, libva, and mesa3d itself.
BR2_PACKAGE_INTEL_MEDIADRIVER=y
# vainfo. Not a debugging luxury: plexos-gpu runs it as the boot-time self-test, so it
# is a required component of the health gate. Selected by BR2_PACKAGE_PLEXOS_GPU too,
# so it cannot be dropped without noticing.
BR2_PACKAGE_LIBVA_UTILS=y
# The diagnostic this project exists for (ARCHITECTURE.md section 6). It was missing
# from the first images that booted, which made the one question the appliance is
# supposed to answer the one thing it could not.
BR2_PACKAGE_PLEXOS_GPU=y

# ---------------------------------------------------------------------------
# Firmware
# ---------------------------------------------------------------------------
BR2_PACKAGE_LINUX_FIRMWARE=y
# GuC/HuC. HuC is what gives QuickSync its quality at low bitrates, and its absence is
# silent — which is the whole reason plexos-gpu::firmware exists.
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
# Wireless-AC 9560 on the reference machine.
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
# Realtek USB Gigabit adapters (r8152). The reference laptop has no built-in Ethernet,
# and a media server on wireless is not a serious configuration — see the note below.
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y

# ---------------------------------------------------------------------------
# Storage and verity
# ---------------------------------------------------------------------------
# cryptsetup provides veritysetup, which plexos-init calls to establish dm-verity over
# /usr before mounting it (ADR-0004).
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_XFSPROGS=y
BR2_PACKAGE_EROFS_UTILS=y

# ---------------------------------------------------------------------------
# Host tooling for image assembly
# ---------------------------------------------------------------------------
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_GPTFDISK=y
# host veritysetup. The verity tree over the /usr image has to be computed on the
# build host, and its root hash embedded in the UKI command line before the UKI is
# signed (ADR-0004). The target-side BR2_PACKAGE_CRYPTSETUP above is a different
# thing entirely: that one is for the device, this one is for the image build.
BR2_PACKAGE_HOST_CRYPTSETUP=y
# host mkfs.erofs comes in via BR2_TARGET_ROOTFS_EROFS, which depends on
# host-erofs-utils (fs/erofs/erofs.mk). Not repeated here.

BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PLEXOS_PATH)/board/plexos/x86_64/post-image.sh"

# ---------------------------------------------------------------------------
# Bootloader
# ---------------------------------------------------------------------------
# Our own package, not Buildroot's. Buildroot's BR2_PACKAGE_SYSTEMD_BOOT sits inside
# `if BR2_PACKAGE_SYSTEMD`, which is only ever selected by the BR2_INIT_SYSTEMD
# choice — taking it would pull systemd in as PID 1, exactly what BR2_INIT_NONE above
# rejects. package/plexos-systemd-boot builds the bootloader, and the UKI stub, alone
# from the same source. The prefix keeps our symbol distinct from upstream's, which
# kconfig would otherwise merge with ours without saying so.
BR2_PACKAGE_PLEXOS_SYSTEMD_BOOT=y

# ---------------------------------------------------------------------------
# Resolved
# ---------------------------------------------------------------------------
# UKI ASSEMBLY. systemd's `ukify` needs python-pefile, which Buildroot does not carry.
# Not a problem: a UKI is the EFI stub with .osrel, .cmdline, .linux, and .initrd PE
# sections added, which objcopy does. post-image.sh does it that way and avoids the
# dependency entirely; the host objcopy was confirmed to support pei-x86-64.
#
# The stub itself comes from package/plexos-systemd-boot, which builds linuxx64.efi.stub
# alongside the bootloader. Upstream Buildroot's systemd package never installs it,
# so without that addition there would be nothing to build a UKI around.
