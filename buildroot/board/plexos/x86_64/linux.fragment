# PlexOS kernel requirements, applied on top of the architecture default config.
#
# A fragment rather than a full linux.config, deliberately. A complete .config is
# thousands of lines of architecture defaults in which the handful of options PlexOS
# actually depends on are invisible, and every kernel bump becomes a merge conflict
# over settings nobody chose. This file states requirements and nothing else, so a
# reviewer can see the whole of what PlexOS needs from the kernel on one screen.
#
# The rule that shapes most of it: **=y, not =m**. The initrd inside the UKI is a
# single static binary with no module loader, no udev, and no modules to load
# (ARCHITECTURE.md §3). Anything needed to reach /usr or /var must be built in.

# --- Boot ------------------------------------------------------------------
# The kernel must be directly executable as an EFI image to live inside a UKI.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS_PSTORE=n
# The UKI carries plexos-init in its .initrd section.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# --- Console ---------------------------------------------------------------
# Without these the screen stays black and a panic is invisible: CONFIG_VT alone
# binds tty0 to DUMMY_CONSOLE, which renders nothing. That is survivable under QEMU,
# where the console is a serial port, and not survivable on the reference machine,
# which has no serial port at all -- the first hardware boot showed a black screen
# and a blinking Caps Lock, the kernel's panic signal, with the explanation printed
# to a console nobody could read.
#
# EFI_EARLYCON covers the window before a real console exists, and is reached with
# earlycon=efifb on the command line (post-image.sh puts it there). SYSFB_SIMPLEFB
# hands over from it using the framebuffer the firmware already set up, and
# DRM_FBDEV_EMULATION lets i915 take the console over once it initialises.
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_EFI_EARLYCON=y

# Console font. The reference machine's panel is 2160x1440, and the kernel's default
# 8x16 font puts a 270x90 character grid on it -- legible in a photograph, not to a
# person standing in front of the machine.
#
# Glyph size is the lever here, not resolution: the framebuffer mode is chosen by
# firmware before Linux starts, and once i915 takes the console it drives the panel at
# its native mode regardless. TER16x32 is four times the area of 8x16 and gives a
# 135x45 grid on the same screen.
#
# The smaller fonts stay compiled in so fbcon=font:<name> can pick another at boot
# without rebuilding; the default is set on the kernel command line in post-image.sh.
CONFIG_FONT_TER16x32=y
CONFIG_FONT_TER10x18=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y

# --- Verified /usr (ADR-0004) ----------------------------------------------
# Built in: verity has to be established before any filesystem is mounted, so it
# cannot itself live in a module on a filesystem.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_CRYPTO_SHA256=y

# --- Filesystems -----------------------------------------------------------
# erofs for /usr, XFS for /var, FAT for the ESP, overlay for /etc, tmpfs for /.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_XFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# exFAT, and it is not optional the moment ADR-0010's removable-media path exists.
#
# Windows formats anything above 32 GB as exFAT and offers no FAT32 option for it, so
# "put the .deb on a USB stick" means exFAT on most sticks a person owns. Without this
# the mount fails with EINVAL — an error about *arguments*, which says nothing about the
# filesystem and is the same disguise CONFIG_NFS_V4_1 wore for four build cycles.
#
# The alternative is telling somebody to reformat a drive to install a media server,
# which is not an alternative. In-tree since 5.7, and it needs the NLS tables above,
# which are already here for the ESP.
CONFIG_EXFAT_FS=y
# ISO9660 as well: an image burned to a disc, or more usefully a .iso a person copied,
# is the other thing a package arrives on.
CONFIG_ISO9660_FS=y
# ext4 for a stick formatted on a Linux machine, which is the case for anybody who would
# be reading a Debian package in the first place.
CONFIG_EXT4_FS=y
# Partition labels are how plexos-init finds a slot (ADR-0003).
CONFIG_EFI_PARTITION=y

# --- Storage ---------------------------------------------------------------
# NVMe on the reference machine; AHCI kept for the wider x86-64 target. Both built in:
# a kernel that cannot reach its own root is unbootable, and there is no initramfs
# module to rescue it.
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_SATA_AHCI=y
CONFIG_ATA=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
# UAS is how USB 3 mass storage actually talks. Devices fall back to the older
# bulk-only transport without it, so this is a performance and compatibility
# measure rather than a requirement -- but booting an appliance image from a USB
# stick is a first-class case here, not a curiosity.
CONFIG_USB_UAS=y

# --- Graphics and transcoding ----------------------------------------------
# i915 covers Gen9.5 (Whiskey Lake UHD 620, the reference machine). xe is the newer
# driver for Tiger Lake and later, present so one image serves both.
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_XE=y
# GuC/HuC. Loading them by default is the difference between QuickSync performing as
# it should and degrading silently.
CONFIG_DRM_I915_FORCE_PROBE=""
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# --- Networking ------------------------------------------------------------
# The reference laptop has no built-in Ethernet: only Intel Wireless-AC 9560 (CNVi)
# and a Realtek USB adapter. See the note at the end of this file.
CONFIG_PCI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_RTL8152=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
# Wired adapters common on the mini-PCs PlexOS targets.
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_R8169=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TCP_CONG_BBR=y

# --- Sharing ---------------------------------------------------------------
# ksmbd rather than Samba: in-kernel, and materially faster for large sequential
# reads, which is the entire access pattern of a media library (ARCHITECTURE.md).
CONFIG_SMB_SERVER=y
CONFIG_NFSD=y
CONFIG_NFSD_V4=y

# --- Process isolation -----------------------------------------------------
# Plex runs unprivileged and confined (ADR-0007).
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,yama,bpf"

# --- Trimming --------------------------------------------------------------
# An appliance needs none of these, and each is attack surface plus CVE maintenance.
CONFIG_SOUND=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_AMDGPU=n
CONFIG_WIRELESS_WDS=n
CONFIG_MODULES=n

# ---------------------------------------------------------------------------
# Note: wired Ethernet may arrive over USB
# ---------------------------------------------------------------------------
# The reference machine has no built-in Ethernet — only Intel Wireless-AC 9560 and a
# permanently attached Realtek USB adapter. That is a perfectly ordinary appliance
# configuration, and it is why USB_RTL8152 and the xHCI stack above are built in
# rather than left to a module.
#
# It removes the concern about configuring wireless before a network exists: with a
# wired adapter present at setup, the first-boot flow in ADR-0010 works exactly as
# designed. PlexOS v1 therefore **requires a wired connection at setup**, over PCI or
# USB, and does not support wireless configuration. For a media server that is a
# reasonable requirement rather than a limitation — the wireless-before-network
# ordering can be designed later if it is ever wanted.
#
# One consequence does follow, and it is not obvious. USB devices enumerate later than
# PCI ones, sometimes by seconds. Against the five-second boot target that is enough
# for a network interface to be absent when services start. The boot health gate in
# ADR-0005 must therefore never depend on link state or reachability — it checks Plex
# on loopback. A gate that waited for the network would roll back a perfectly good
# update because a USB dongle was slow to appear, which is precisely the
# too-strict-health-gate failure that ADR-0005 warns about.

# NFS minor versions. CONFIG_NFS_V4 alone gives 4.0 and nothing later, and a client that
# asks for 4.2 against such a kernel is told EINVAL -- an error about arguments, which is
# how four attempts to mount a NAS were spent looking at option strings. 4.1 brings
# sessions and 4.2 brings server-side copy and better read-ahead, both of which matter
# for streaming large files.
#
# CONFIG_NFS_V4_2 depends on CONFIG_NFS_V4_1, which is why both are here.
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
